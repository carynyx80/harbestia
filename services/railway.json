{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd sdk && npm ci && npm run build && cd ../api && npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "node api/dist/server.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
