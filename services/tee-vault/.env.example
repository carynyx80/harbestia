# Copy to .env (gitignored). Never commit real values.
NODE_ENV=development
PORT=8788
# Required in production. If unset in development a random key is generated and printed once at startup.
REVIEWER_KEY=
# JSON map of regulatorId -> Ed25519 public key PEM
REGULATOR_KEYS={}
KYC_AUTO_VERIFY=1
CORS_ORIGIN=http://localhost:3000
