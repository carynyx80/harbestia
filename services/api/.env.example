# Copy to .env (gitignored). Never commit real values.
NODE_ENV=development
PORT=8787
# Required in production. If unset in development a random key is generated and printed once at startup.
ADMIN_KEY=
CORS_ORIGIN=http://localhost:3000
# Privacy backend: "mock" (default, NOT private) or "helius" (Helius Privacy Rings, on-chain shield tx verification).
PRIVACY_MODE=
# "devnet" (default) or "mainnet".
SOLANA_CLUSTER=
# Required when PRIVACY_MODE=helius (optional otherwise). Secret: set in the environment only, never commit.
HELIUS_API_KEY=
# Treasury mode (v4): "on" or "off" (default off). Custodial company treasury wallet; SOLANA_CLUSTER defaults to mainnet when on.
TREASURY_MODE=
# Public address of the company treasury wallet (default DtvUDyUhkehQzp1qWKxaCvYQtm6uHU7QMuSiHeLg3Scx).
TREASURY_WALLET=
# USDC mint (default: mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v; devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU).
USDC_MINT=
# HELIUS_API_KEY (above) is optional in treasury mode: used for /rpc and tx verification, else the public Solana RPC.
